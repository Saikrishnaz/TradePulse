# ============================================================
# TradePulse - environment. Copy to .env; never commit .env.
# TradePulse talks to the OMS ONLY through Redis. It needs no OMS database, no OMS API,
# and keeps working after the OMS host goes down for the day.
# ============================================================

# --- Redis (the OMS's instance; TradePulse reads smx:* and writes only tradepulse:*) ---
# Same values as REDIS_* in the OMS .env.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
TP_OMS_EVENTS_STREAM=smx:oms:events
TP_OMS_COMMAND_STREAMS=smx:oms:cmd:*
# Development only: run without Redis (single process; nothing arrives from the OMS)
TP_MEMORY_BUS=0

# --- TradePulse storage & secrets ----------------------------
TP_DB_PATH=data/tradepulse.db
# Encrypts the bot token / webhook secrets at rest. Generate once:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TP_FERNET_KEY=
# First administrator, created only when TradePulse has no users. Better: import the OMS users once:
#   python -m tradepulse.admin import-oms --db /path/to/skymatrix.db
TP_ADMIN_USERNAME=admin
TP_ADMIN_PASSWORD=

# --- web --------------------------------------------------------
TP_HOST=127.0.0.1
TP_PORT=8895
TP_PUBLIC_BASE_URL=https://pulse.skymatrixpartners.com
TP_COOKIE_SECURE=1
TP_SESSION_HOURS=12
# 1 = run workers inside the web process. 0 = run `python -m tradepulse.worker` separately.
TP_RUN_WORKERS=1

# --- Telegram ---------------------------------------------------
TP_TELEGRAM_BOT_TOKEN=
# polling (no public URL needed) | webhook (set from the dashboard; needs TP_PUBLIC_BASE_URL) | off
TP_TELEGRAM_MODE=polling

# --- broker webhooks (optional) -----------------------------------
TP_WEBHOOK_RATE_PER_MIN=600

# Reconcile times, the 3-second broker spacing (minimum 3) and market hours are set in the
# dashboard: System -> Monitoring frequency.

# --- next-day signals (POST /api/signals/next-day) -------------
# Same value as SMX_PRESIG_KEY in the OMS .env (a Fernet key). The OMS publishes each algo key's secret
# encrypted with it, so the signal generator signs with ONE secret for both servers. Unset = every
# next-day signal is refused with INVALID_CREDENTIALS.
SMX_PRESIG_KEY=
